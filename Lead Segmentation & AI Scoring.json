        "sendTo": "",
        "subject": "=New Lead Alert: {{ $json.name }}",
        "message": "=<p>Hi Team,</p>\n<p>A new lead has just been registered. Here are the details:</p>\n\n<p><strong>📌 Source:</strong> Website Contact Form</p>\n\n<div style=\"background-color: #f9f9f9; padding: 15px; border-left: 4px solid #4caf50; margin: 15px 0;\">\n    <p style=\"margin: 5px 0;\"><strong>👤 Name:</strong> {{ $('Merge Score + Lead Data').item.json.name }}</p>\n    <p style=\"margin: 5px 0;\"><strong>📧 Email:</strong> {{ $('Merge Score + Lead Data').item.json.email }}</p>\n    <p style=\"margin: 5px 0;\"><strong>📞 Phone:</strong> {{ $('Merge Score + Lead Data').item.json.phone }}</p>\n    <p style=\"margin: 5px 0;\"><strong>🏷️ Lead Type:</strong> {{ $('Merge Score + Lead Data').item.json.leadType }}</p>\n    <p style=\"margin: 5px 0;\">\n        <strong>⭐ AI Score:</strong> {{ $('Merge Score + Lead Data').item.json.score }}/10\n        {{ $('Merge Score + Lead Data').item.json.scored == false ? ' <span style=\"color: #d9534f; font-size: 12px; font-weight: bold;\">⚠️ Default score (AI was unavailable)</span>' : '' }}\n    </p>\n</div>\n\n<p style=\"margin-top: 20px; color: #d9534f; font-weight: bold;\">⚠️ Immediate Action Required:</p>\n<p>Please follow up with this lead within 24 hours.</p>\n\n<hr>\n<p style=\"font-size: 12px; color: #777; font-style: italic;\">This email was sent automatically via n8n Lead Automation</p>",
        "options": {}
