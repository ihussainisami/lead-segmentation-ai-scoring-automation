      "parameters": {
        "jsCode": "const aiOutput = $input.first().json;\n\n// Log the full structure so you can see what Groq actually returned\nconsole.log(JSON.stringify(aiOutput));\n\nconst scoreText = aiOutput.choices?.[0]?.message?.content \n  || aiOutput?.body?.choices?.[0]?.message?.content \n  || '0';\n\nconst score = parseInt(scoreText.trim()) || 0;\nconst originalData = $('Classify Lead by Domain').item.json;\n\n// Check if AI actually returned a score (vs fallback)\nconst isScored = aiOutput.choices?.[0]?.message?.content ? true : false;\n\nreturn {\n  json: {\n    name: originalData.name,\n    email: originalData.email,\n    phone: originalData.phone,\n    leadType: originalData.leadType,\n    score: score,\n    scored: isScored  // <-- YE LINE ADD KARI HAI\n  }\n};"
